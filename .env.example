# VaultTec environment — copy to .env and fill in. NEVER commit .env.
# Phase 1 needs no keys at all (sample data provider is the default).
VAULTTEC_ENV=development
VAULTTEC_DATA_PROVIDER=sample
# Future (Phase 2+): market data / LLM keys go here, never in code.
# MARKET_DATA_API_KEY=
# LLM_API_KEY=

# PRIVATE live trading (Neko only — see vaulttec/private_live/RUNBOOK.md).
# Paper is the default. Live needs ALL THREE locks: the flag below,
# ALPACA_PAPER=false, AND private_live/LIVE_CONFIRMATION.txt.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_PAPER=true
# VAULTTEC_LIVE_TRADING_ENABLED=false
